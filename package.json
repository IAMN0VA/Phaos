{
  "name": "phaos-educational-medical-imaging",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preflight": "node scripts/preflight.mjs && node --check src/main.js",
    "test": "node --test tests/*.test.mjs",
    "audit:privacy": "node scripts/privacy-audit.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "audit:anatomy": "node scripts/anatomy-audit.mjs",
    "launch:check": "npm run preflight && npm test && npm run audit:privacy && npm run audit:security && npm run audit:anatomy && npm run audit:a11y && npm run audit:claims",
    "audit:a11y": "node scripts/accessibility-audit.mjs",
    "audit:lock": "node scripts/lockfile-audit.mjs",
    "release:check": "npm run audit:lock && npm run launch:check && npm run build",
    "audit:claims": "node scripts/claims-audit.mjs"
  },
  "dependencies": {
    "@cornerstonejs/core": "5.8.2",
    "@cornerstonejs/dicom-image-loader": "5.8.2",
    "@cornerstonejs/tools": "5.8.2",
    "dicom-parser": "1.8.21",
    "fflate": "0.8.3",
    "events": "3.3.0",
    "@kitware/vtk.js": "36.4.1"
  },
  "devDependencies": {
    "@originjs/vite-plugin-commonjs": "1.0.3",
    "vite": "5.4.19"
  },
  "overrides": {
    "@cornerstonejs/codec-libjpeg-turbo-8bit": "1.2.2",
    "@cornerstonejs/codec-charls": "1.2.3",
    "@cornerstonejs/codec-openjpeg": "1.3.0",
    "@cornerstonejs/codec-openjph": "2.4.7"
  },
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  }
}
